# Comma-separated "label=token" pairs. Append ":full" to a token's value (e.g.
# "you=some-random-token:full") to make that person's logins bypass access tiers
# entirely — everyone else's tokens still go through the gate below.
MCP_ACCESS_TOKENS=you=some-random-token:full

# Optional. Comma-separated character names (matching their wiki/entities/ page title),
# or "ALL", unlocked for non-":full" tokens. Unset = everything gated stays locked for
# them. Ignored for ":full" tokens, which bypass this regardless.
# UNLOCKED_CHARACTERS=

# Optional. If set, enables the db_add_note / db_edit_note / db_delete_note / db_list_notes
# tools, scoped to the mcp_notes table only. Point this at the same Postgres database
# db-sync/ uses if you want it on the same instance, or leave unset to disable the tools.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/secondbrain
